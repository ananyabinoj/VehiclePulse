# Groq API (required for live LLM analysis; without this the app runs in Demo Mode)
# Get a key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI API (optional — only used for semantic embeddings, not for analysis)
# If not set, local lexical vectors are used for similarity and theme clustering.
OPENAI_API_KEY=

PORT=8787
